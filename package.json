{
  "name": "tiny-browser",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --stream dev",
    "start": "pnpm --filter @tinybrowser/gateway start",
    "build": "pnpm --recursive run build",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm build && pnpm --recursive run test && node --test examples/hosted-app/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
